<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    UIA feedback relay (Feedback-Pipeline-Plan.md §2). Standalone service - NOT part of the
    game mod build, not referenced by Dev/StationeersUIMod.Dev.csproj.

    Target: net10.0 (LTS, supported to November 2028). Moved from net9.0 on 2026-09-26, ahead
    of .NET 9's end of support (2026-11-10). The Dell does not need .NET installed: publish
    self-contained (see README.md) - the runtime ships inside the publish folder.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FeedbackRelay</RootNamespace>
    <AssemblyName>FeedbackRelay</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Not hosted in IIS: don't generate a web.config on publish. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the same exe run as a Windows service (no-op when started from a console). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

</Project>
