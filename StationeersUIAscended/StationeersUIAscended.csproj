<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>StationeersUIAscended</AssemblyName>
    <RootNamespace>StationeersUIAscended</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Embedded PDBs are required for ScriptEngine hot reload -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Override with -p:GameDir="..." for non-default installs -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stationeers</GameDir>
    <Managed>$(GameDir)\rocketstation_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(Managed)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(Managed)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(Managed)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule" Private="false">
      <HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Private="false">
      <HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Private="false">
      <HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="RG.ImGui" Private="false">
      <HintPath>$(Managed)\RG.ImGui.dll</HintPath>
    </Reference>
    <Reference Include="RG.ImGui.Unity" Private="false">
      <HintPath>$(Managed)\RG.ImGui.Unity.dll</HintPath>
    </Reference>
    <Reference Include="UniTask" Private="false">
      <HintPath>$(Managed)\UniTask.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Stage a StationeersLaunchPad folder mod into both local mods directories -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <UserModDir>$(USERPROFILE)\Documents\My Games\Stationeers\mods\StationeersUIAscended</UserModDir>
      <GameModDir>$(GameDir)\mods\StationeersUIAscended</GameModDir>
    </PropertyGroup>
    <ItemGroup>
      <AboutFiles Include="About\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UserModDir)" />
    <Copy SourceFiles="@(AboutFiles)" DestinationFiles="@(AboutFiles->'$(UserModDir)\About\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameModDir)" />
    <Copy SourceFiles="@(AboutFiles)" DestinationFiles="@(AboutFiles->'$(GameModDir)\About\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="Packaged SLP mod folder to $(UserModDir) and $(GameModDir)" Importance="high" />
  </Target>

</Project>
